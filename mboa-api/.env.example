# Copier en `.env` et renseigner les valeurs. Le vrai fichier n'est pas
# versionné : il porte le mot de passe de la base et le secret de signature.

ENVIRONMENT=development
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Chaîne aléatoire, propre à chaque installation. Une valeur partagée entre
# deux environnements laisserait un jeton d'un serveur ouvrir l'autre.
JWT_SECRET=
